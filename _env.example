# Database
DATABASE_URL=postgresql+asyncpg://agentuser:agentpass@localhost/agentdb

# LLM provider (ADR-002: OpenAI is canonical; Anthropic kept as fallback for demo)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here  # optional fallback

# Razorpay (test mode only — ADR-005)
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Platform Ed25519 keypair — generate once and pin so public key stays stable across deploys.
# Generate: python3 -c "from cryptography.hazmat.primitives.asymmetric import ed25519; from cryptography.hazmat.primitives import serialization; import base64; k=ed25519.Ed25519PrivateKey.generate(); print(base64.b64encode(k.private_bytes(serialization.Encoding.Raw,serialization.PrivateFormat.Raw,serialization.NoEncryption())).decode())"
PLATFORM_PRIVATE_KEY_B64=your_base64_ed25519_private_key_here

# JWT (ADR-012 auth). Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_here_at_least_32_chars
# Token lifetime in minutes (default 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Platform fee percentage (default 2.5%). Python applies this at settlement time.
PLATFORM_FEE_PCT=0.025

# Resend API key for transactional email (deal_closed, delivery_reminder)
RESEND_API_KEY=re_your_resend_key_here

# MCP server → backend URL (used by mcp_server/server.py)
# Local dev: http://localhost:8000
# Production (Render): https://your-backend-service.onrender.com
BACKEND_URL=http://localhost:8000

# Frontend → backend URL (used by Vite/axios in production)
# Local dev: leave empty (Vite proxy handles /api → localhost:8000)
# Production (Vercel): https://your-backend-service.onrender.com
VITE_API_URL=

# MCP server
MCP_PORT=8001

# Backend
BACKEND_PORT=8000
